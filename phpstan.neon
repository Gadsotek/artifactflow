includes:
  - vendor/larastan/larastan/extension.neon
  - phpstan-baseline.neon

parameters:
  level: max
  paths:
    - app
    - bootstrap
    - config
    - database
    - routes
    - tests
    - image-parser
    - pdf-processor-spike/src/PdfProcessor.php
  parallel:
    maximumNumberOfProcesses: 4
  tmpDir: storage/phpstan
