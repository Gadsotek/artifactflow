{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "artifactflow",
  "description": "Versioned artifact vault for tools and documents created with AI.",
  "homepage": "https://artifactflow.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gadsotek/artifactflow.git"
  },
  "bugs": {
    "url": "https://github.com/Gadsotek/artifactflow/issues"
  },
  "keywords": [
    "artifactflow",
    "laravel",
    "html-artifacts"
  ],
  "author": "Gadsotek <gadsotek@gmail.com>",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "shell-quote": "1.10.0"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "laravel-echo": "^2.4.0",
    "mermaid": "11.17.2",
    "pusher-js": "^8.6.0",
    "tabulator-tables": "6.5.2"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint:js": "eslint resources/js \"site/assets/*.js\" eslint.config.js vite.config.js",
    "format": "prettier --write \"resources/js/**/*.js\" \"site/assets/*.js\"",
    "format:check": "prettier --check \"resources/js/**/*.js\" \"site/assets/*.js\"",
    "e2e": "playwright test",
    "e2e:debug": "playwright test --debug",
    "e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "laravel-vite-plugin": "^3.2.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.2",
    "vite": "^8.2.2"
  }
}
