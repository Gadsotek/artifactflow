{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["dockerfile", "docker-compose", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Trivy scanner used for image scans and release SBOMs",
      "managerFilePatterns": ["docker/trivy-image.txt"],
      "matchStrings": [
        "^(?<depName>aquasec/trivy):(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "dependencyDashboard": { "enabled": true },
  "labels": ["dependencies", "docker"],
  "pinDigests": true,
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "commitBody": "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  "packageRules": [
    {
      "description": "Keep the Node build and Compose runtime on the same pinned image",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchPackageNames": ["node"],
      "groupName": "node container image",
      "groupSlug": "node-container-image"
    }
  ]
}
