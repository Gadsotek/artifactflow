+// own TestEncrypterWithBrokenRand covers encryption-entropy failures.
+func assertEncryptedPayload(t *testing.T, got *JSONWebEncryption, password, payload []byte, contentType string) {
+	t.Helper()
+	require.NotNil(t, got)
+	serialized, err := got.CompactSerialize()
+	require.NoError(t, err)
+	parts := strings.Split(serialized, ".")
+	require.Len(t, parts, 5)
+	protected, err := base64.RawURLEncoding.DecodeString(parts[0])
+	require.NoError(t, err)
+	var header struct {
+		Algorithm   string `json:"alg"`
+		ContentType string `json:"cty"`
+		Encryption  string `json:"enc"`
+		Iterations  int    `json:"p2c"`
+		Salt        string `json:"p2s"`
+	}
+	require.NoError(t, json.Unmarshal(protected, &header))
+	assert.Equal(t, string(PBES2_HS256_A128KW), header.Algorithm)
+	assert.Equal(t, contentType, header.ContentType)
+	assert.Equal(t, string(DefaultEncAlgorithm), header.Encryption)
+	assert.Equal(t, PBKDF2Iterations, header.Iterations)
+	salt, err := base64.RawURLEncoding.DecodeString(header.Salt)
+	require.NoError(t, err)
+	assert.Len(t, salt, PBKDF2SaltSize)
+	for _, representation := range []string{serialized, got.FullSerialize()} {
+		parsed, err := ParseEncrypted(representation)
+		require.NoError(t, err)
+		plaintext, err := parsed.Decrypt(password)
+		require.NoError(t, err)
+		assert.Equal(t, payload, plaintext)
+		_, err = parsed.Decrypt([]byte("incorrect password"))
+		require.Error(t, err)
+	}
+}
